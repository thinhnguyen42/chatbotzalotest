{
    "name": "zalo-oa-bot",
    "version": "1.0.0",
    "description": "Zalo OA chatbot - rule-based + AI fallback",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --exec ts-node src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "lint": "tsc --noEmit",
        "test": "echo \"No tests specified\"",
        "ingest": "ts-node scripts/ingest.ts",
        "token:exchange": "ts-node scripts/exchangeCode.ts",
        "token:set": "ts-node scripts/setToken.ts"
    },
    "dependencies": {
        "@types/node-cron": "^3.0.11",
        "axios": "^1.7.7",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "form-data": "^4.0.6",
        "node-cron": "^4.6.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.14.9",
        "nodemon": "^3.1.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.5.3"
    }
}
